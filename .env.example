# ============================================
# Garmin to Notion - Configuration
# ============================================
# Copy this file to .env and fill in your values.
# See README.md for setup instructions.

# --- Required ---
GARMIN_EMAIL=your@email.com
GARMIN_PASSWORD=your-garmin-password
NOTION_TOKEN=ntn_your_token_here

# --- Required if your Garmin account has MFA/2FA enabled ---
# Generate with: python scripts/generate_token.py
# GARMIN_TOKENS=

# --- Optional: Database IDs (auto-discovered if not set) ---
# NOTION_DB_ID=
# NOTION_PR_DB_ID=
# NOTION_STEPS_DB_ID=
# NOTION_SLEEP_DB_ID=
# NOTION_WORKOUTS_DB_ID=
# NOTION_SUMMARY_DB_ID=

# --- Optional: Settings ---
# TIMEZONE=UTC
# GARMIN_DAYS_BACK=30
# GARMIN_ACTIVITIES_FETCH_LIMIT=1000
# SYNC_SLEEP=true

# --- Optional: Fitbit sleep via the Google Health API ---
# Leave unset to skip. Generate the refresh token with:
#   PYTHONPATH=src python scripts/generate_google_health_token.py
# GOOGLE_HEALTH_CLIENT_ID=
# GOOGLE_HEALTH_CLIENT_SECRET=
# GOOGLE_HEALTH_REFRESH_TOKEN=
# FITBIT_DAYS_BACK=30   # defaults to GARMIN_DAYS_BACK
